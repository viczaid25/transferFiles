@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpCtx
@inject IConfiguration Configuration
@inject transferFiles.Auth.AuthMode AuthMode
@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    string active(string c, string? a = null) =>
        (ctrl == c.ToLower() && (a is null || act == a.ToLower())) ? "active" : "";

    // Identidad: SOLO claims del contrato con meaxHub (idénticos en modo dev y hub).
    var pcLoginId = User.PcLoginId() ?? "";
    var userDepartment = User.Department();
    var userPosition = User.Position();
    var employeeId = User.EmployeeId();
    var systemRole = User.SystemRole();

    // Iniciales para el avatar del navbar (solo presentación).
    var displayName = User.NombreParaMostrar() ?? "Usuario";
    var nameParts = displayName.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length >= 2
        ? string.Concat(char.ToUpperInvariant(nameParts[0][0]), char.ToUpperInvariant(nameParts[1][0]))
        : new string(displayName.Where(char.IsLetter).Take(2).ToArray()).ToUpperInvariant();
    if (string.IsNullOrEmpty(initials)) { initials = "?"; }

    var hubBaseUrl = Configuration["Hub:BaseUrl"]?.TrimEnd('/');
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060B29">
    <title>@ViewData["Title"] - Transfer Files</title>

    <link rel="manifest" href="~/manifest.json" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/meaxone-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/meaxone-template.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/meaxone-app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="mo-body">

    <div id="mo-app">

        <!-- ══ NAVBAR ══════════════════════════════════════════ -->
        <nav id="mo-navbar">
            <div id="mo-stripe"></div>

            <button id="mo-hamburger" type="button" onclick="moToggleSidebar()" aria-label="Mostrar/Ocultar menú">
                <span></span><span></span><span></span>
            </button>

            <a id="mo-logo" asp-controller="Home" asp-action="Index">
                <img id="mo-logo-img" src="~/images/logo-mitsubishi.png" alt="" />
                <div>
                    <div id="mo-logo-text">Transfer Files</div>
                    <div id="mo-logo-sub">Parte de MEAX One</div>
                </div>
            </a>

            <div class="mo-spacer"></div>

            @if (AuthMode.DevLoginActivo)
            {
                <span class="mo-badge mo-badge-warning" title="Login local sin Meax One (solo entorno Development)">
                    ⚠ MODO DESARROLLO — login sin Meax One
                </span>
            }

            <div id="mo-user-wrap">
                <button id="mo-user-btn" type="button" onclick="moToggleUserMenu(event)">
                    <div id="mo-user-avatar">@initials</div>
                    <span id="mo-user-name">@displayName</span>
                    <svg id="mo-user-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                <div id="mo-user-dropdown">
                    <div id="mo-user-dropdown-header">
                        <div class="mo-dd-avatar">@initials</div>
                        <div>
                            <div class="mo-dd-name">@displayName</div>
                            <div class="mo-dd-login">
                                @pcLoginId@(string.IsNullOrWhiteSpace(employeeId) ? "" : $" · Nómina {employeeId}")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(userDepartment) || !string.IsNullOrWhiteSpace(userPosition))
                    {
                        <div class="mo-dd-divider"></div>
                        <div class="mo-dd-item" style="cursor:default;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
                            </svg>
                            <span>@string.Join(" · ", new[] { userDepartment, userPosition }.Where(v => !string.IsNullOrWhiteSpace(v)))</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(systemRole))
                    {
                        <div class="mo-dd-item" style="cursor:default;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z" />
                            </svg>
                            <span>Rol: <strong data-system-role>@systemRole</strong></span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(hubBaseUrl))
                    {
                        <div class="mo-dd-divider"></div>
                        <a class="mo-dd-item" href="@hubBaseUrl">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" />
                            </svg>
                            <span>Volver al Hub</span>
                        </a>
                    }

                    <div class="mo-dd-divider"></div>
                    <a class="mo-dd-item mo-dd-logout" asp-controller="Account" asp-action="Logout">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m16 17 5-5-5-5" /><path d="M21 12H9" /><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        </svg>
                        <span>Cerrar sesión</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- ══ SHELL ═══════════════════════════════════════════ -->
        <div id="mo-content-area">

            <!-- SIDEBAR -->
            <aside id="mo-sidebar">
                <nav id="mo-sb-nav">
                    <div class="mo-sb-section-label">GENERAL</div>

                    <a class="mo-sb-item @active("Home", "Index")" asp-controller="Home" asp-action="Index">
                        <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                        <span class="mo-sb-label">Home</span>
                    </a>

                    <a class="mo-sb-item @active("Transfers", "New")" asp-controller="Transfers" asp-action="New">
                        <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" />
                        </svg>
                        <span class="mo-sb-label">Crear link</span>
                    </a>

                    <a class="mo-sb-item @active("Links", "Mine")" asp-controller="Links" asp-action="Mine">
                        <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                        </svg>
                        <span class="mo-sb-label">Mis links</span>
                    </a>
                </nav>

                <div id="mo-sb-version">
                    <span class="mo-sb-version-text">v1.0.0</span>
                </div>
            </aside>

            <!-- MAIN -->
            <main id="mo-main">
                @RenderBody()
            </main>
        </div>
    </div>

    @* Base de la app (incluye el PathBase cuando corre como sub-aplicación de
       IIS). CONVENCIÓN DEL PROYECTO: ningún .js debe llevar rutas quemadas —
       construirlas siempre como window.appBase + 'controlador/accion'. *@
    <script>window.appBase = '@Url.Content("~/")';</script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/meaxone-app.js" asp-append-version="true"></script>
    <script src="~/js/meaxone-table.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (!AuthMode.DevLoginActivo && !string.IsNullOrWhiteSpace(hubBaseUrl))
    {
        @* Heartbeat: mantiene viva la cookie .MEAX.JWT del hub (8 h).
           Silencioso si el hub no responde — nunca rompe la página. *@
        <script>
            (function () {
                var heartbeatUrl = '@Html.Raw(hubBaseUrl)/auth/heartbeat';

                function latido() {
                    try {
                        fetch(heartbeatUrl, { method: 'POST', credentials: 'include' })
                            .catch(function () { /* hub no disponible: ignorar */ });
                    } catch (e) { /* ignorar */ }
                }

                latido();
                setInterval(latido, 12 * 60 * 1000);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
