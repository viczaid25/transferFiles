@{
    ViewData["Title"] = "Nuevo Transfer";
}

<div class="mo-page-wrap">

    <div class="mo-page-header">
        <div>
            <h2>Generar link de archivos</h2>
            <p>Sube uno o varios archivos y obtén un link protegido con contraseña.</p>
        </div>
    </div>

    <div class="mo-panel">
        <form id="createTransferForm" asp-action="New" method="post" enctype="multipart/form-data">

            <div class="mo-form-group">
                <label class="mo-form-label" for="filesInput">Selecciona archivos</label>
                <input id="filesInput" type="file" name="files" multiple class="mo-form-control" required />
                <div class="mo-form-hint">Puedes seleccionar uno o varios archivos.</div>
            </div>

            <div class="mo-form-group">
                <label class="mo-form-label" for="reasonInput">Razón</label>
                <textarea id="reasonInput"
                          name="message"
                          class="mo-form-control"
                          rows="3"
                          placeholder="Describe la razón de la transferencia..."
                          required></textarea>
                <div class="mo-form-hint">Este campo es obligatorio.</div>
            </div>

            <div class="mo-page-actions justify-content-end">
                <a asp-controller="Home" asp-action="Index" class="mo-btn mo-btn-secondary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12 19-7-7 7-7" /><path d="M19 12H5" />
                    </svg>
                    Cancelar
                </a>

                <button id="submitBtn" type="submit" class="mo-btn mo-btn-primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                    Crear link
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Overlay de carga -->
<div id="loadingOverlay" class="tf-overlay d-none" aria-hidden="true">
    <div class="tf-overlay-card">
        <img src="~/images/uploading.gif" class="tf-gif" alt="Subiendo..." />
        <div class="tf-overlay-title">Generando link…</div>
        <div class="tf-overlay-sub">Subiendo archivos a TransferNow. No cierres esta ventana.</div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
          const form = document.getElementById('createTransferForm');
          const overlay = document.getElementById('loadingOverlay');
          const btn = document.getElementById('submitBtn');

          const BTN_IDLE = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
                         + '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>'
                         + '<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Crear link';

          const BTN_BUSY = '<svg class="mo-spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
                         + '<path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Generando…';

          form?.addEventListener('submit', () => {
            // (El browser validará required automáticamente)
            if (btn) {
              btn.disabled = true;
              btn.innerHTML = BTN_BUSY;
            }
            if (overlay) {
              overlay.classList.remove('d-none');
              overlay.setAttribute('aria-hidden', 'false');
            }
          });

          // Si el usuario vuelve con "Back" del navegador, re-habilitar UI
          window.addEventListener('pageshow', () => {
            if (btn) {
              btn.disabled = false;
              btn.innerHTML = BTN_IDLE;
            }
            if (overlay) {
              overlay.classList.add('d-none');
              overlay.setAttribute('aria-hidden', 'true');
            }
          });
        })();
    </script>
}
