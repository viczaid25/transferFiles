@{
    ViewData["Title"] = "Sin acceso";
}

<div class="mo-page-wrap">
    <div class="mo-page-header">
        <div>
            <h2>No tienes acceso a esta sección</h2>
            <p>Tu sesión está activa, pero tu cuenta no tiene el permiso necesario.</p>
        </div>
    </div>

    <div class="mo-panel">
        <div class="mo-alert mo-alert-warning">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <div>
                <span class="mo-alert-title">Permiso insuficiente</span>
                La vista de administración es para quienes tienen el rol <strong>Admin</strong>
                de este sistema en Meax One. Si necesitas acceso, pídelo al área de IT.
            </div>
        </div>

        <div class="mo-page-actions mt-4">
            <a asp-controller="Home" asp-action="Index" class="mo-btn mo-btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                Volver al inicio
            </a>
            <a asp-controller="Links" asp-action="Mine" class="mo-btn mo-btn-secondary">
                Mis links
            </a>
        </div>
    </div>
</div>
