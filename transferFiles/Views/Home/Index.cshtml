@model transferFiles.Models.ViewModels.HomeIndexVm
@{
    ViewData["Title"] = "Inicio";
}

<!-- ══ BANNER ═══════════════════════════════════════════════ -->
<div id="mo-banner">
    <div class="mo-banner-orb mo-banner-orb-1"></div>
    <div class="mo-banner-orb mo-banner-orb-2"></div>

    <div id="mo-banner-content">
        <div id="mo-banner-tag">Panel principal</div>
        @* Saludo con el nombre para mostrar del hub; Model.CurrentUser es el
           login de red (PcLoginId), que es la llave contra la BD. *@
        <div id="mo-banner-title">Bienvenido, @(User.NombreParaMostrar() ?? Model.CurrentUser)</div>
        <div id="mo-banner-sub">
            Genera y administra tus links de transferencia.
            Los links tienen vigencia de @Model.ValidityDays días.
        </div>
    </div>

    <div id="mo-banner-actions">
        <a asp-controller="Transfers" asp-action="New" class="mo-btn mo-btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" />
            </svg>
            Crear link
        </a>
        <a asp-controller="Links" asp-action="Mine" class="mo-btn mo-btn-secondary-outline">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            Mis links
        </a>
    </div>
</div>

<div class="mo-page-wrap">

    <!-- ══ CONTEOS ══════════════════════════════════════════ -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="mo-stat">
                <div class="mo-stat-label">Total de mis links</div>
                <div class="mo-stat-value">@Model.TotalMyLinks</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="mo-stat">
                <div class="mo-stat-label">Activos</div>
                <div class="mo-stat-value is-success">@Model.ActiveMyLinks</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="mo-stat">
                <div class="mo-stat-label">Expirados</div>
                <div class="mo-stat-value is-danger">@Model.ExpiredMyLinks</div>
            </div>
        </div>
    </div>

    <!-- ══ ÚLTIMOS LINKS ════════════════════════════════════ -->
    <div class="mo-section-title">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l4 2" />
        </svg>
        Últimos links generados
    </div>

    @if (Model.Recent.Count == 0)
    {
        <div class="mo-alert mo-alert-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" />
            </svg>
            <div>Aún no has generado links. ¡Crea el primero!</div>
        </div>
    }
    else
    {
        <div class="mo-table-wrap">
            <table class="mo-table">
                <thead>
                    <tr>
                        <th>Creado (UTC)</th>
                        <th>Archivo</th>
                        <th>Expira (UTC)</th>
                        <th>Estado</th>
                        <th>Link</th>
                        <th style="width:1%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Recent)
                    {
                        var badge = row.IsExpired ? "mo-badge-danger" : "mo-badge-success";
                        <tr>
                            <td>@row.CreatedAtUtc</td>
                            <td class="mo-cell-truncate">@row.FileName</td>
                            <td>@row.ExpiresAtUtc</td>
                            <td>
                                <span class="mo-badge @badge">
                                    <span class="mo-badge-dot"></span>@(row.IsExpired ? "Expired" : "Active")
                                </span>
                            </td>
                            <td class="mo-cell-truncate mo-cell-truncate-lg">
                                <a href="@row.Link" target="_blank" rel="noopener">@row.Link</a>
                            </td>
                            <td>
                                <button type="button"
                                        class="mo-btn mo-btn-secondary-outline mo-btn-sm copy-link-btn"
                                        data-link="@row.Link" title="Copiar">
                                    Copiar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mo-page-actions justify-content-end mt-3">
            <a asp-controller="Links" asp-action="Mine" class="mo-btn mo-btn-primary-outline mo-btn-sm">
                Ver todos
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('click', async (e) => {
          const btn = e.target.closest('.copy-link-btn');
          if (!btn) return;
          const url = btn.getAttribute('data-link');
          try {
            await navigator.clipboard.writeText(url);
            btn.textContent = 'Copiado';
            setTimeout(() => btn.textContent = 'Copiar', 1200);
          } catch {
            const tmp = document.createElement('input');
            tmp.value = url;
            document.body.appendChild(tmp);
            tmp.select();
            document.execCommand('copy');
            document.body.removeChild(tmp);
            btn.textContent = 'Copiado';
            setTimeout(() => btn.textContent = 'Copiar', 1200);
          }
        });
    </script>
}
