@model IEnumerable<transferFiles.Models.ViewModels.TransferLinkRowVm>
@using System.Linq
@using System

@{
    ViewData["Title"] = "Mis links generados";
    int validityDays = ViewBag.ValidityDays ?? 7;
}

<div class="mo-page-wrap">

    <div class="mo-page-header">
        <div>
            <h2>@ViewData["Title"]</h2>
            <p>Usuario: <strong>@(ViewBag.CurrentUser ?? "")</strong></p>
        </div>
        <div class="mo-page-actions">
            <span class="mo-badge mo-badge-primary">
                Vigencia: @validityDays día@(validityDays == 1 ? "" : "s")
            </span>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="mo-alert mo-alert-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" />
            </svg>
            <div>Aún no has generado links.</div>
        </div>
    }
    else
    {
        <div class="mo-table-wrap" data-mo-table data-page-size="10">
            <table class="mo-table" id="linksTable">
                <thead>
                    <tr>
                        <th>Creado</th>
                        <th>Expira</th>
                        <th>Archivo</th>
                        <th>Link</th>
                        <th>Estatus</th>
                        <th>Contraseña</th>
                        <th style="width:1%"></th>
                    </tr>
                    <tr class="mo-table-filter-row">
                        <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="Filtrar…" /></th>
                        <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="Filtrar…" /></th>
                        <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="Filtrar…" /></th>
                        <th><input class="mo-th-filter" data-mo-filter-col="3" placeholder="Filtrar…" /></th>
                        <th>
                            <select class="mo-th-filter" data-mo-filter-col="4">
                                <option value="">Todos</option>
                                <option>Active</option>
                                <option>Expired</option>
                            </select>
                        </th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var badgeClass = row.IsExpired ? "mo-badge-danger" : "mo-badge-success";
                        <tr>
                            <td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(row.CreatedAtUtc, DateTimeKind.Utc), TimeZoneInfo.Local).ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(row.ExpiresAtUtc, DateTimeKind.Utc), TimeZoneInfo.Local).ToString("yyyy-MM-dd HH:mm")
                                @if (!row.IsExpired)
                                {
                                    <div class="mo-form-hint">~@Math.Ceiling(row.Remaining.TotalHours) h restantes</div>
                                }
                            </td>
                            <td class="mo-cell-truncate">@row.FileName</td>

                            <td class="mo-cell-truncate mo-cell-truncate-lg">
                                <a href="@row.Link" target="_blank" rel="noopener">@row.Link</a>
                            </td>

                            <td>
                                <span class="mo-badge @badgeClass">
                                    <span class="mo-badge-dot"></span>@(row.IsExpired ? "Expired" : "Active")
                                </span>
                            </td>

                            <!-- Columna contraseña -->
                            <td class="text-nowrap">
                                @if (!string.IsNullOrEmpty(row.Password))
                                {
                                    <div class="mo-input-row mo-input-row-sm" style="max-width:240px">
                                        <input type="password"
                                               class="mo-form-control pwd-field"
                                               value="@row.Password"
                                               readonly />
                                        <button type="button"
                                                class="mo-btn mo-btn-secondary-outline mo-btn-sm toggle-pwd-btn"
                                                title="Mostrar/Ocultar">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />
                                            </svg>
                                        </button>
                                        <button type="button"
                                                class="mo-btn mo-btn-secondary-outline mo-btn-sm copy-pwd-btn"
                                                title="Copiar contraseña">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                            </svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="mo-form-hint">—</span>
                                }
                            </td>

                            <td class="text-nowrap">
                                <div class="mo-page-actions" style="gap:6px;">
                                    <button type="button"
                                            class="mo-btn mo-btn-secondary-outline mo-btn-sm copy-link-btn"
                                            data-link="@row.Link"
                                            title="Copiar link">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                        </svg>
                                    </button>
                                    <a class="mo-btn mo-btn-primary mo-btn-sm" href="@row.Link" target="_blank" rel="noopener" title="Abrir">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mo-table-pagination" data-mo-pagination></div>
    }
</div>

@section Scripts {
    <script>
        (function () {
          const CHECK = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

          const EYE = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>';

          const EYE_OFF = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
                        + '<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>'
                        + '<path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>'
                        + '<path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>'
                        + '<line x1="2" x2="22" y1="2" y2="22"/></svg>';

          async function copy(text) {
            try { await navigator.clipboard.writeText(text); }
            catch {
              const tmp = document.createElement('input');
              tmp.value = text; document.body.appendChild(tmp);
              tmp.select(); document.execCommand('copy');
              document.body.removeChild(tmp);
            }
          }

          // Copiar LINK
          document.addEventListener('click', async (e) => {
            const linkBtn = e.target.closest('.copy-link-btn');
            if (!linkBtn) return;
            const url = linkBtn.getAttribute('data-link') || '';
            if (!url) return;

            const old = linkBtn.innerHTML;
            await copy(url);
            linkBtn.innerHTML = CHECK;
            setTimeout(() => linkBtn.innerHTML = old, 1100);
          });

          // Mostrar/ocultar contraseña por fila
          document.addEventListener('click', (e) => {
            const toggleBtn = e.target.closest('.toggle-pwd-btn');
            if (!toggleBtn) return;
            const group = toggleBtn.closest('.mo-input-row');
            const input = group?.querySelector('.pwd-field');
            if (!input) return;

            if (input.type === 'password') {
              input.type = 'text';
              toggleBtn.innerHTML = EYE_OFF;
            } else {
              input.type = 'password';
              toggleBtn.innerHTML = EYE;
            }
          });

          // Copiar contraseña por fila
          document.addEventListener('click', async (e) => {
            const copyPwdBtn = e.target.closest('.copy-pwd-btn');
            if (!copyPwdBtn) return;
            const group = copyPwdBtn.closest('.mo-input-row');
            const input = group?.querySelector('.pwd-field');
            if (!input) return;

            const old = copyPwdBtn.innerHTML;
            await copy(input.value || '');
            copyPwdBtn.innerHTML = CHECK;
            setTimeout(() => copyPwdBtn.innerHTML = old, 1100);
          });

        })();
    </script>
}
