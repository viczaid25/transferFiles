@model transferFiles.Models.ViewModels.AdminLinksVm
@using System
@{
    ViewData["Title"] = "Todos los links";
}

<div class="mo-page-wrap">

    <div class="mo-page-header">
        <div>
            <h2>@ViewData["Title"]</h2>
            <p>Vista de administración: links generados por todos los usuarios.</p>
        </div>
        <div class="mo-page-actions">
            <span class="mo-badge mo-badge-primary">@Model.UsuariosDistintos usuarios</span>
            <span class="mo-badge mo-badge-secondary">@Model.DepartamentosDistintos departamentos</span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="mo-stat">
                <div class="mo-stat-label">Total de links</div>
                <div class="mo-stat-value">@Model.Total</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="mo-stat">
                <div class="mo-stat-label">Activos</div>
                <div class="mo-stat-value is-success">@Model.Activos</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="mo-stat">
                <div class="mo-stat-label">Expirados</div>
                <div class="mo-stat-value is-danger">@Model.Expirados</div>
            </div>
        </div>
    </div>

    @if (Model.Total == 0)
    {
        <div class="mo-alert mo-alert-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" />
            </svg>
            <div>Todavía no hay links generados.</div>
        </div>
    }
    else
    {
        <div class="mo-table-wrap" data-mo-table data-page-size="25">
            <table class="mo-table">
                <thead>
                    <tr>
                        <th>Creado</th>
                        <th>Usuario</th>
                        <th>Login</th>
                        <th>Departamento</th>
                        <th>Archivo</th>
                        <th>Razón</th>
                        <th>Expira</th>
                        <th>Estatus</th>
                        <th style="width:1%"></th>
                    </tr>
                    <tr class="mo-table-filter-row">
                        <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="Filtrar…" /></th>
                        <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="Filtrar…" /></th>
                        <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="Filtrar…" /></th>
                        <th>
                            <select class="mo-th-filter" data-mo-filter-col="3">
                                <option value="">Todos</option>
                                @foreach (var dep in Model.Departamentos)
                                {
                                    <option>@dep</option>
                                }
                            </select>
                        </th>
                        <th><input class="mo-th-filter" data-mo-filter-col="4" placeholder="Filtrar…" /></th>
                        <th><input class="mo-th-filter" data-mo-filter-col="5" placeholder="Filtrar…" /></th>
                        <th></th>
                        <th>
                            <select class="mo-th-filter" data-mo-filter-col="7">
                                <option value="">Todos</option>
                                <option>Active</option>
                                <option>Expired</option>
                            </select>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Items)
                    {
                        var badgeClass = row.IsExpired ? "mo-badge-danger" : "mo-badge-success";
                        <tr>
                            <td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(row.CreatedAtUtc, DateTimeKind.Utc), TimeZoneInfo.Local).ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="mo-cell-truncate">@row.NombreOLogin</td>
                            <td>@row.Login</td>
                            <td>@(row.Departamento ?? "—")</td>
                            <td class="mo-cell-truncate">@row.FileName</td>
                            <td class="mo-cell-truncate">@(row.Reason ?? "—")</td>
                            <td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(row.ExpiresAtUtc, DateTimeKind.Utc), TimeZoneInfo.Local).ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="mo-badge @badgeClass">
                                    <span class="mo-badge-dot"></span>@(row.IsExpired ? "Expired" : "Active")
                                </span>
                            </td>
                            <td class="text-nowrap">
                                <a class="mo-btn mo-btn-secondary-outline mo-btn-sm" href="@row.Link" target="_blank" rel="noopener" title="Abrir link">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mo-table-pagination" data-mo-pagination></div>

        <div class="mo-form-hint mt-3">
            El filtrado y la paginación ocurren en el navegador sobre las @Model.Total filas ya cargadas.
            Cuando la tabla crezca a varios miles, conviene paginar del lado del servidor.
        </div>
    }
</div>
