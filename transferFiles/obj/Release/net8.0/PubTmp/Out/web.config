<?xml version="1.0" encoding="utf-8"?>
<!--
  Este web.config existe SOLO para subirle a IIS el límite de tamaño de petición.
  El SDK le inyecta al publicar el resto (handler aspNetCore, processPath,
  hostingModel), así que aquí no hay que repetir nada de eso.

  Por qué es necesario: la app sube archivos de hasta 2 GB. El límite de Kestrel
  que se configura en Program.cs solo aplica corriendo en local; bajo IIS con
  hostingModel="inprocess" mandan IISServerOptions.MaxRequestBodySize (también en
  Program.cs) y este maxAllowedContentLength, cuyo default son ~30 MB.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 2 GB en bytes -->
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\transferFiles.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
</configuration>
