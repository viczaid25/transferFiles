<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <!-- DEJAR EN false. Con true, la publicación recrea la carpeta y se pierde
         la entrada de permisos propia del app pool del sitio (las demás apps de
         este servidor tienen una explícita); IIS deja de poder leer el
         web.config y responde 500.19 / 0x80070005.
         Ojo con el otro riesgo, ya resuelto aquí: con false la publicación omite
         archivos cuyo destino tiene fecha más nueva que el origen. Esta carpeta
         ya se limpió una vez, así que los DLLs viejos de Microsoft.IdentityModel
         6.35 no están. Si algún día vuelve a aparecer un 500 al validar el token,
         borra a mano solo esos 7 archivos (Microsoft.IdentityModel.*.dll y
         System.IdentityModel.Tokens.Jwt.dll) y publica de nuevo. -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>\\MEAXS013\inetpub\meaxTransfer</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>